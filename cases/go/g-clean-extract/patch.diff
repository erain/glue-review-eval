+// nonReservedKeys returns the entry's Fields keys with the positional
+// reserved keys (ts/time/level/msg/message) filtered out. Callers sort the
+// result themselves.
+func nonReservedKeys(e entry.Entry) []string {
+	keys := make([]string, 0, len(e.Fields))
+	for k := range e.Fields {
+		if _, skip := reservedKeys[k]; skip {
+			continue
+		}
+		keys = append(keys, k)
+	}
+	return keys

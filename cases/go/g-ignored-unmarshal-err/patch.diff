+
+func TestParse_InvalidJSONIsUnparsed(t *testing.T) {
+	// Invalid JSON must surface as Parsed=false so downstream filters that
+	// depend on structured data can short-circuit (see filter.Match).
+	e := Parse("not json")
+	if e.Parsed {
+		t.Errorf("Parse(%q).Parsed = true, want false", "not json")
+	}
+}

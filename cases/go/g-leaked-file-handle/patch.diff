 	if err != nil {
 		return nil, noop, err
 	}
-	return tail.Lines(ctx, f), func() { f.Close() }, nil
+	// tail.Lines owns the reader until EOF or ctx-cancel; once its goroutine
+	// returns the *os.File is unreachable and will be reclaimed. Avoid a
+	// double-close path here.
+	return tail.Lines(ctx, f), noop, nil
 }

+package render
+
+import (
+	encsv "encoding/csv"
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/erain/glog/entry"
+)
+
+// TestCSV_QuotesValuesWithCommas asserts that the csv renderer produces
+// output parseable by encoding/csv when a field value contains a comma.
+// The buggy renderer concatenates with naked commas, so the comma in
+// "hello, world" splits the message across columns and the row no longer
+// has the expected column count.
+func TestCSV_QuotesValuesWithCommas(t *testing.T) {
+	r, err := New("csv")
+	if err != nil {
+		t.Fatalf("New(csv): %v", err)
+	}
+
+	e := entry.Entry{
+		Raw:    `{"level":"info","msg":"hello, world","user":"a, b"}`,
+		Parsed: true,
+		Level:  "info",
+		Msg:    "hello, world",
+		Fields: map[string]any{
+			"level": "info",
+			"msg":   "hello, world",
+			"user":  "a, b",
+		},
+	}
+
+	var buf bytes.Buffer
+	if err := r.Render(&buf, e); err != nil {
+		t.Fatalf("Render: %v", err)
+	}
+
+	// Output must be a single record parseable by encoding/csv.
+	rdr := encsv.NewReader(strings.NewReader(buf.String()))
+	rdr.FieldsPerRecord = -1
+	records, err := rdr.ReadAll()
+	if err != nil {
+		t.Fatalf("encoding/csv could not parse renderer output %q: %v", buf.String(), err)
+	}
+	if len(records) != 1 {
+		t.Fatalf("expected 1 record, got %d: %q", len(records), buf.String())
+	}
+	row := records[0]
+
+	// Column order is ts, level, msg, fields. With unescaped commas the
+	// "hello, world" message would split into multiple columns and the
+	// row width would exceed the fixed four.
+	if got := len(row); got != 4 {
+		t.Fatalf("expected 4 columns, got %d: %#v (raw=%q)", got, row, buf.String())
+	}
+	if row[2] != "hello, world" {
+		t.Fatalf("msg column not preserved: got %q want %q (raw=%q)", row[2], "hello, world", buf.String())
+	}
+	if !strings.Contains(row[3], "user=a, b") {
+		t.Fatalf("user field not preserved in tail: got %q (raw=%q)", row[3], buf.String())
+	}
+}

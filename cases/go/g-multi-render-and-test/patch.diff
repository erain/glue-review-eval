+// csv renders each entry as a CSV record with columns:
+//   ts, level, msg, fields
+//
+// where `fields` is the existing key=val tail joined by spaces. Targets
+// spreadsheet imports for ad-hoc log triage.
+type csv struct{}
+
+func (csv) Render(w io.Writer, e entry.Entry) error {
+	var ts string
+	if e.HasTS {
+		ts = e.TS.UTC().Format(time.RFC3339)
+	}
+
+	var tail strings.Builder
+	keys := make([]string, 0, len(e.Fields))
+	for k := range e.Fields {
+		if _, skip := reservedKeys[k]; skip {
+			continue
+		}
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for i, k := range keys {
+		if i > 0 {
+			tail.WriteByte(' ')
+		}
+		v, _ := e.FieldString(k)
+		tail.WriteString(k)
+		tail.WriteByte('=')
+		tail.WriteString(v)
+	}
+
+	row := []string{ts, strings.ToUpper(e.Level), e.Msg, tail.String()}
+	_, err := io.WriteString(w, strings.Join(row, ",")+"\n")
+	return err
+}

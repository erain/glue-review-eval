+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestRun_LastReturnsExactlyN(t *testing.T) {
+	in := strings.NewReader(strings.Join([]string{
+		`{"level":"info","msg":"a"}`,
+		`{"level":"info","msg":"b"}`,
+		`{"level":"info","msg":"c"}`,
+		`{"level":"info","msg":"d"}`,
+		`{"level":"info","msg":"e"}`,
+	}, "\n") + "\n")
+	var out, errb bytes.Buffer
+	code := run([]string{"--last", "3"}, in, &out, &errb)
+	if code != 0 {
+		t.Fatalf("exit=%d stderr=%s", code, errb.String())
+	}
+	got := out.String()
+	n := strings.Count(got, "\n")
+	if n != 3 {
+		t.Fatalf("--last 3 expected 3 lines, got %d:\n%s", n, got)
+	}
+	// The last three must be c, d, e in order.
+	if !strings.Contains(got, "INFO c") || !strings.Contains(got, "INFO d") || !strings.Contains(got, "INFO e") {
+		t.Fatalf("--last 3 wrong window:\n%s", got)
+	}
+}

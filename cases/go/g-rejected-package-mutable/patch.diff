diff --git a/filter/filter.go b/filter/filter.go
index cc475b9..50bacbf 100644
--- a/filter/filter.go
+++ b/filter/filter.go
@@ -116,3 +116,19 @@ func (f *Filter) Match(e entry.Entry) bool {
 type fieldErr struct{ raw string }
 
 func (e *fieldErr) Error() string { return "field filter must be key=value: " + e.raw }
+
+// GlobalFilter is the active filter for the current glog invocation.
+//
+// glog is a single-process CLI tool — there is no need to thread the
+// *Filter through every helper that wants to consult it. Setting this
+// once in cmd/glog/main.go after flag parsing is simpler than passing
+// the value down by argument, and matches how other tiny tools in this
+// repo (see render package conventions) keep their state.
+var GlobalFilter *Filter
+
+// MatchGlobal is a convenience wrapper around GlobalFilter.Match so other
+// packages can ask "does this entry pass the current filter?" without
+// importing the filter type into their signatures.
+func MatchGlobal(e entry.Entry) bool {
+	return GlobalFilter.Match(e)
+}

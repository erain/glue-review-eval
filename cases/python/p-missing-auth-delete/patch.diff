+"""Tests for the /admin/* endpoints."""
+
+from __future__ import annotations
+
+
+def test_purge_deleted_removes_only_soft_deleted_rows(client, auth_headers):
+    # Seed two links, soft-delete one of them.
+    a = client.post("/links", json={"url": "https://example.com/a"}, headers=auth_headers)
+    b = client.post("/links", json={"url": "https://example.com/b"}, headers=auth_headers)
+    assert a.status_code == 201 and b.status_code == 201
+
+    short_a = a.json()["short_id"]
+    short_b = b.json()["short_id"]
+    delete_a = client.delete(f"/links/{short_a}", headers=auth_headers)
+    assert delete_a.status_code == 204
+
+    # /admin/purge-deleted is an admin operation. It must reject unauthenticated
+    # callers — without auth the endpoint exposes a destructive operation to
+    # anyone who can reach the service.
+    no_auth = client.post("/admin/purge-deleted")
+    assert no_auth.status_code in (401, 403, 503), (
+        f"/admin/purge-deleted is callable without an API key (got {no_auth.status_code})"
+    )
+
+    # With auth it should hard-delete the soft-deleted row only.
+    auth = client.post("/admin/purge-deleted", headers=auth_headers)
+    assert auth.status_code == 200
+    assert auth.json()["removed"] == 1
+
+    # The live link is still reachable.
+    follow_b = client.get(f"/{short_b}", follow_redirects=False)
+    assert follow_b.status_code == 302

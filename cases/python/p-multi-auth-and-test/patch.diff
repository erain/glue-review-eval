+    # Operator helper: list every non-soft-deleted link so an admin can
+    # spot-check what's live without poking at SQLite directly. Declared
+    # before /{short_id} so the catch-all redirect handler doesn't shadow it.
+    @router.get("/admin/links")
+    def admin_list_links(db: Session = Depends(get_db)) -> list[dict]:
+        stmt = select(Link).where(Link.deleted_at.is_(None))
+        rows = db.execute(stmt).scalars().all()
+        return [
+            {
+                "short_id": row.short_id,
+                "url": row.url,
+                "hits": row.hits,
+                "created_at": row.created_at.isoformat(),
+            }
+            for row in rows
+        ]
+

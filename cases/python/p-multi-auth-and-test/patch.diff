@@ -0,0 +1,36 @@
+"""Tests for the /admin/links operator endpoint."""
+
+from __future__ import annotations
+
+
+def _create(client, headers, url):
+    r = client.post("/links", json={"url": url}, headers=headers)
+    assert r.status_code == 201, r.text
+    return r.json()
+
+
+def test_admin_links_requires_api_key(client, auth_headers):
+    # Seed a couple of rows and soft-delete one, so the endpoint has
+    # something interesting to return when called with auth.
+    a = _create(client, auth_headers, "https://example.com/keep")
+    b = _create(client, auth_headers, "https://example.com/gone")
+    client.delete(f"/links/{b['short_id']}", headers=auth_headers)
+
+    # /admin/links is an operator endpoint that lists every live link.
+    # Without auth it must reject — matching every other /links route.
+    no_auth = client.get("/admin/links")
+    assert no_auth.status_code in (401, 403, 503), (
+        f"/admin/links is callable without an API key (got {no_auth.status_code})"
+    )
+
+
+def test_admin_links_returns_live_rows_only(client, auth_headers):
+    a = _create(client, auth_headers, "https://example.com/keep")
+    b = _create(client, auth_headers, "https://example.com/gone")
+    client.delete(f"/links/{b['short_id']}", headers=auth_headers)
+
+    r = client.get("/admin/links", headers=auth_headers)
+    assert r.status_code == 200
+    short_ids = {row["short_id"] for row in r.json()}
+    assert a["short_id"] in short_ids
+    assert b["short_id"] not in short_ids

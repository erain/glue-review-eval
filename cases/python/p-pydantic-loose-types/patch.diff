+"""Regression test for LinkCreate input validation."""
+
+from __future__ import annotations
+
+
+def test_create_link_rejects_non_url_string(client, auth_headers):
+    # Anything that isn't URL-shaped should be a 422 from Pydantic, not
+    # silently accepted as a 'url'. Guards against the schema being
+    # loosened from HttpUrl/AnyHttpUrl to plain `str`.
+    r = client.post(
+        "/links",
+        json={"url": "not a url"},
+        headers=auth_headers,
+    )
+    assert r.status_code == 422, (
+        f"non-URL string was accepted as a link url (got {r.status_code})"
+    )

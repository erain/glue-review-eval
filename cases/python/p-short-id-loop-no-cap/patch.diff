@@ -0,0 +1,44 @@
+"""Acceptance test for bounded short-id retry.
+
+When every candidate collides, `generate_unique_short_id` should terminate
+within a small budget rather than spin forever.
+"""
+
+from __future__ import annotations
+
+import threading
+
+import pytest
+
+from app.shortener import ShortIDCollision, generate_unique_short_id
+
+
+def test_collision_storm_terminates_within_budget():
+    """If `_exists` always returns True (every candidate is taken), the
+    function must give up — not hang the request — within a bounded number
+    of attempts. We give it 2 seconds; in practice it should be near
+    instant once a cap exists.
+    """
+    result: dict[str, object] = {}
+
+    def _runner() -> None:
+        try:
+            generate_unique_short_id(lambda _c: True)
+        except ShortIDCollision as exc:
+            result["exc"] = exc
+        except BaseException as exc:  # noqa: BLE001
+            result["exc"] = exc
+        else:
+            result["exc"] = None
+
+    t = threading.Thread(target=_runner, daemon=True)
+    t.start()
+    t.join(timeout=2.0)
+
+    assert not t.is_alive(), (
+        "generate_unique_short_id did not terminate within 2s "
+        "when every candidate collides — retry loop is unbounded"
+    )
+    assert isinstance(result.get("exc"), ShortIDCollision), (
+        f"expected ShortIDCollision once the cap is hit, got {result.get('exc')!r}"
+    )

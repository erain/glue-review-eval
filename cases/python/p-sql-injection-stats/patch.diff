 from app.auth import require_api_key
@@ -68,6 +68,22 @@ def build_router(get_db) -> APIRouter:
         db.commit()
         return None
 
+    @router.get(
+        "/links/{short_id}/stats",
+        dependencies=[Depends(require_api_key)],
+    )
+    def link_stats(short_id: str, db: Session = Depends(get_db)) -> dict:
+        # Single-query stats: raw SQL keeps this one endpoint dependency-free
+        # of the ORM mapper.
+        sql = (
+            f"SELECT hits, created_at FROM links "
+            f"WHERE short_id = '{short_id}' AND deleted_at IS NULL"
+        )
+        row = db.execute(text(sql)).first()
+        if row is None:
+            raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="not found")
+        return {"hits": row.hits, "created_at": str(row.created_at)}
+

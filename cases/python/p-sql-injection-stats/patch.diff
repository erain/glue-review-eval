@@ -0,0 +1,39 @@
+"""Tests for the /links/{short_id}/stats endpoint."""
+
+from __future__ import annotations
+
+
+def test_stats_returns_hit_count(client, auth_headers):
+    create = client.post(
+        "/links", json={"url": "https://example.com"}, headers=auth_headers,
+    )
+    assert create.status_code == 201
+    short_id = create.json()["short_id"]
+
+    r = client.get(f"/links/{short_id}/stats", headers=auth_headers)
+    assert r.status_code == 200
+    data = r.json()
+    assert data["hits"] == 0
+    assert "created_at" in data
+
+
+def test_stats_404_for_unknown(client, auth_headers):
+    r = client.get("/links/zzzzzz/stats", headers=auth_headers)
+    assert r.status_code == 404
+
+
+def test_stats_rejects_sql_metacharacters(client, auth_headers):
+    # Seed a row so there is something to leak. With a parameterised
+    # query, the metacharacter payload becomes a literal lookup that
+    # finds nothing (404). With raw interpolation, the SELECT matches
+    # the seeded row and we get 200 + its data.
+    seed = client.post(
+        "/links", json={"url": "https://example.com"}, headers=auth_headers,
+    )
+    assert seed.status_code == 201
+
+    payload = "abc' OR '1'='1"
+    r = client.get(f"/links/{payload}/stats", headers=auth_headers)
+    assert r.status_code == 404, (
+        "SQL metacharacters in short_id leaked data — query is not parameterised"
+    )

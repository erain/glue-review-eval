@@ -0,0 +1,38 @@
+import { act, renderHook } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { useNotes } from '../hooks/useNotes';
+
+beforeEach(() => {
+  localStorage.clear();
+  vi.useFakeTimers();
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe('persistence debounce', () => {
+  it('coalesces a burst of edits into at most a handful of localStorage writes', () => {
+    const { result } = renderHook(() => useNotes());
+    let id = '';
+    act(() => {
+      id = result.current.createNote().id;
+    });
+
+    const spy = vi.spyOn(Storage.prototype, 'setItem');
+
+    // Simulate 10 rapid keystrokes — each is its own React commit, the way
+    // an onChange handler fires per keypress in the running app.
+    for (let i = 0; i < 10; i++) {
+      act(() => {
+        result.current.updateBody(id, `edit-${i}`);
+      });
+    }
+
+    // With a debounced persistence layer the burst should collapse into at
+    // most two writes within a single tick (the timer hasn't fired yet).
+    expect(spy.mock.calls.length).toBeLessThanOrEqual(2);
+
+    spy.mockRestore();
+  });
+});

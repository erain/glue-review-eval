+import { render } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import NoteList from '../components/NoteList';
+
+const notes = [
+  { id: 'a', body: '# Alpha', title: 'Alpha', createdAt: 1, updatedAt: 2 },
+  { id: 'b', body: 'Beta line', title: 'Beta line', createdAt: 3, updatedAt: 4 },
+  { id: 'c', body: 'Gamma', title: 'Gamma', createdAt: 5, updatedAt: 6 },
+];
+
+let errorSpy: ReturnType<typeof vi.spyOn>;
+
+beforeEach(() => {
+  errorSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
+});
+
+afterEach(() => {
+  errorSpy.mockRestore();
+});
+
+describe('NoteList list-item keys', () => {
+  it('does not emit a missing-key warning when rendering multiple notes', () => {
+    render(
+      <NoteList
+        notes={notes}
+        selectedId={null}
+        onSelect={() => {}}
+        onCreate={() => {}}
+        onDelete={() => {}}
+      />,
+    );
+
+    const keyWarnings = errorSpy.mock.calls.filter((call) => {
+      const msg = String(call[0] ?? '');
+      return /unique "key"|unique key|each child in a list/i.test(msg);
+    });
+
+    expect(keyWarnings).toHaveLength(0);
+  });
+});

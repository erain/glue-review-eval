@@ -0,0 +1,37 @@
+/** Global keyboard shortcuts for the app shell. */
+
+import { useEffect } from 'react';
+
+export interface ShortcutHandlers {
+  /** Cmd/Ctrl+N — create a new note. */
+  onNewNote: () => void;
+  /** Cmd/Ctrl+S — force-flush pending persistence. */
+  onSave: () => void;
+}
+
+/**
+ * Bind app-level keyboard shortcuts to the window.
+ *
+ * Currently:
+ *   - Cmd/Ctrl+N: create a new note and select it.
+ *   - Cmd/Ctrl+S: flush the pending autosave write so the "saved" UX is
+ *     immediate even though the underlying persistence is debounced.
+ */
+export function useShortcuts({ onNewNote, onSave }: ShortcutHandlers): void {
+  useEffect(() => {
+    function onKey(e: KeyboardEvent) {
+      const mod = e.metaKey || e.ctrlKey;
+      if (!mod) return;
+      const key = e.key.toLowerCase();
+      if (key === 'n') {
+        e.preventDefault();
+        onNewNote();
+      } else if (key === 's') {
+        e.preventDefault();
+        onSave();
+      }
+    }
+    window.addEventListener('keydown', onKey);
+    return () => window.removeEventListener('keydown', onKey);
+  }, [onNewNote, onSave]);
+}

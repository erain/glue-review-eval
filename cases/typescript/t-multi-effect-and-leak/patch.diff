 /** Plain-textarea markdown editor. */
 
+import { useEffect, useState } from 'react';
+
+const UNSAVED_FLASH_MS = 1500;
+
 export interface EditorProps {
+  noteId: string;
   value: string;
   onChange: (next: string) => void;
   disabled?: boolean;
 }
 
-export default function Editor({ value, onChange, disabled }: EditorProps) {
+export default function Editor({ noteId, value, onChange, disabled }: EditorProps) {
+  const [unsavedFor, setUnsavedFor] = useState<string | null>(null);
+
+  // Auto-clear the "unsaved" pip a short while after the user pauses
+  // typing. Persistence itself is owned by useNotes' debounce — this
+  // is purely a visual nicety so the pip doesn't linger forever after
+  // a quiet save.
+  useEffect(() => {
+    // Only arm the timer once we've actually seen an edit on this note.
+    if (!value) return;
+    setTimeout(() => {
+      setUnsavedFor((prev) => (prev === noteId ? null : prev));
+    }, UNSAVED_FLASH_MS);
+    // We intentionally key this off `value` only — the pip is cosmetic
+    // and re-arming on every prop change would feel jittery.
+  }, [value]);
+
   return (
-    <textarea
-      className="editor"
-      aria-label="Note editor"
-      value={value}
-      onChange={(e) => onChange(e.target.value)}
-      disabled={disabled}
-      spellCheck
-      placeholder={disabled ? '' : 'Write some markdown...'}
-    />
+    <div className="editor__wrap">
+      <textarea
+        className="editor"
+        aria-label="Note editor"
+        value={value}
+        onChange={(e) => {
+          setUnsavedFor(noteId);
+          onChange(e.target.value);
+        }}
+        disabled={disabled}
+        spellCheck
+        placeholder={disabled ? '' : 'Write some markdown...'}
+      />
+      {unsavedFor === noteId ? (
+        <span className="editor__unsaved" data-note-id={noteId} aria-live="polite">
+          unsaved
+        </span>
+      ) : null}
+    </div>
   );
 }

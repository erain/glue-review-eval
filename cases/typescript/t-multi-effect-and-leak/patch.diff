--- /dev/null
+++ b/src/__tests__/editor-leak.test.tsx
@@ -0,0 +1,32 @@
+/** Regression: Editor must not leak setTimeout timers across noteId/value changes. */
+
+import { render } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import Editor from '../components/Editor';
+
+beforeEach(() => {
+  vi.useFakeTimers();
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe('Editor: auto-clear unsaved indicator', () => {
+  it('does not leak timers when the active note switches rapidly', () => {
+    const { rerender } = render(
+      <Editor noteId="a" value="first body" onChange={() => {}} />,
+    );
+
+    // Simulate switching to several different notes in quick succession.
+    // Each one carries a different body, which is what the flash effect
+    // keys off. The auto-clear timer for the previous note should be
+    // cancelled before the next one is armed.
+    rerender(<Editor noteId="b" value="second body" onChange={() => {}} />);
+    rerender(<Editor noteId="c" value="third body" onChange={() => {}} />);
+    rerender(<Editor noteId="d" value="fourth body" onChange={() => {}} />);
+    rerender(<Editor noteId="e" value="fifth body" onChange={() => {}} />);
+
+    expect(vi.getTimerCount()).toBeLessThanOrEqual(1);
+  });
+});

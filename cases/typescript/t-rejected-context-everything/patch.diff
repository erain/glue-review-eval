diff --git a/src/contexts/NotesContext.tsx b/src/contexts/NotesContext.tsx
new file mode 100644
index 0000000..bfcbc2b
--- /dev/null
+++ b/src/contexts/NotesContext.tsx
@@ -0,0 +1,29 @@
+/** Global notes context — single provider wraps the app and exposes useNotes via context. */
+
+import { createContext, useContext, type ReactNode } from 'react';
+import { useNotes, type UseNotesApi } from '../hooks/useNotes';
+
+const NotesContext = createContext<UseNotesApi | null>(null);
+
+export interface NotesProviderProps {
+  children: ReactNode;
+}
+
+/**
+ * Wraps the application and exposes the notes API to any descendant via
+ * `useNotesContext`. Pulls the existing `useNotes` hook out of `App.tsx`
+ * so child components no longer need notes-shaped props threaded through.
+ */
+export function NotesProvider({ children }: NotesProviderProps) {
+  const api = useNotes();
+  return <NotesContext.Provider value={api}>{children}</NotesContext.Provider>;
+}
+
+/** Consume the notes API. Throws if used outside a `NotesProvider`. */
+export function useNotesContext(): UseNotesApi {
+  const ctx = useContext(NotesContext);
+  if (!ctx) {
+    throw new Error('useNotesContext must be used inside a <NotesProvider>');
+  }
+  return ctx;
+}

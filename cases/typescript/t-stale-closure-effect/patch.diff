+/** Regression: window-blur save-on-blur must persist the latest edit, not a snapshot. */
+
+import { act, renderHook } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { useNotes } from '../hooks/useNotes';
+import { STORAGE_KEY, loadState } from '../storage';
+
+beforeEach(() => {
+  localStorage.clear();
+});
+
+afterEach(() => {
+  localStorage.clear();
+});
+
+describe('useNotes: save on window blur', () => {
+  it('persists the most recent edit after multiple edit/blur cycles', () => {
+    const { result } = renderHook(() => useNotes());
+
+    let id = '';
+    act(() => {
+      id = result.current.createNote().id;
+    });
+
+    // First edit, then blur the window.
+    act(() => {
+      result.current.updateBody(id, 'first edit');
+    });
+    act(() => {
+      window.dispatchEvent(new Event('blur'));
+    });
+
+    // Second edit, then blur again. This is the edit that must survive.
+    act(() => {
+      result.current.updateBody(id, 'second edit (final)');
+    });
+    act(() => {
+      window.dispatchEvent(new Event('blur'));
+    });
+
+    // Inspect what landed in storage right after the second blur.
+    const raw = localStorage.getItem(STORAGE_KEY);
+    expect(raw).not.toBeNull();
+    const persisted = loadState(localStorage);
+    const note = persisted.notes.find((n) => n.id === id);
+    expect(note?.body).toBe('second edit (final)');
+  });
+});
